{
	"semi": true,
	"singleQuote": false,
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"bracketSpacing": false,
	"trailingComma": "all",
	"arrowParens": "always",
	"proseWrap": "never",
	"embeddedLanguageFormatting": "off",
	"overrides": [
		{
			"files": [".yamllint.yaml", "**/*.yaml", "**/*.yml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		},
		{
			"files": ["**/*.md"],
			"options": {
				"printWidth": 320
			}
		}
	]
}
