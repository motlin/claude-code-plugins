{
	"semi": true,
	"singleQuote": true,
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"bracketSpacing": false,
	"trailingComma": "all",
	"arrowParens": "always",
	"proseWrap": "never",
	"embeddedLanguageFormatting": "off",
	"overrides": [
		{
			"files": ["*.md"],
			"options": {
				"printWidth": 320
			}
		}
	]
}
