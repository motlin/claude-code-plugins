#!/usr/bin/env bash
# Replay all branches onto upstream/main or matching up-to-date origin branch
# Usage: replay-all
#
# Non-interactive alternative to `rebase-all` that uses `git replay` instead of
# `git rebase`. No branch checkout needed since `git replay` only updates refs.
# A branch that fails to replay is left where it was and reported at the end.
#
# Environment variables:
#   UPSTREAM_REMOTE - Remote to replay onto (default: upstream)
#   UPSTREAM_BRANCH - Branch to replay onto (default: main)
#   OFFLINE         - Skip fetching if true (default: false)
#   KEEP_GOING      - Exit zero even when some branches fail to replay (default: false)

set -Eeuo pipefail

upstream_remote="${UPSTREAM_REMOTE:-upstream}"
upstream_branch="${UPSTREAM_BRANCH:-main}"
keep_going="${KEEP_GOING:-false}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check for local modifications
"$SCRIPT_DIR/check-local-modifications"

# Fetch upstream
"$SCRIPT_DIR/fetch"

# Get branches that are not ancestors of upstream/main
mapfile -t branches < <(git for-each-ref --format='%(refname:short)' refs/heads/ --sort -committerdate --no-contains "${upstream_remote}/${upstream_branch}")
mapfile -t checked_out_branches < <(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p')
total=${#branches[@]}
current=0
failed_branches=()

for branch in "${branches[@]}"
do
    current=$((current + 1))

    # Skip branches included in other branches
    included_count=$(git branch --contains "$branch" | wc -l)
    if [ "$included_count" -gt 1 ]; then
        echo "[${current}/${total}] Skipping branch $branch as it is included in other branches"
        continue
    fi

    # git replay moves refs without touching any checkout, which would leave the checkout with upstream's changes reversed and staged
    checked_out_in_stack=""
    while read -r stacked_branch; do
        for checked_out_branch in "${checked_out_branches[@]}"; do
            if [ "$stacked_branch" = "$checked_out_branch" ]; then
                checked_out_in_stack="$stacked_branch"
            fi
        done
    done < <(git for-each-ref --format='%(refname:short)' refs/heads/ --merged "$branch" --no-merged "${upstream_remote}/${upstream_branch}")
    if [ -n "$checked_out_in_stack" ]; then
        echo "[${current}/${total}] Skipping branch $branch as $checked_out_in_stack is checked out"
        continue
    fi

    replay_message="[${current}/${total}] Replaying branch $branch onto"

    onto="${upstream_remote}/${upstream_branch}"
    if git rev-parse --verify "origin/$branch" &>/dev/null; then
        if git merge-base --is-ancestor "${upstream_remote}/${upstream_branch}" "origin/$branch"; then
            onto="origin/$branch"
            echo "$replay_message origin/$branch (because origin/$branch exists and is up-to-date with ${upstream_remote}/${upstream_branch})"
        else
            echo "$replay_message ${upstream_remote}/${upstream_branch} (because origin/$branch exists but is not an ancestor)"
        fi
    else
        echo "$replay_message ${upstream_remote}/${upstream_branch} (because origin/$branch does not exist)"
    fi

    if ! git replay --contained --onto "$onto" "$onto..$branch" 2>&1; then
        echo "[${current}/${total}] Failed to replay branch $branch (conflict)"
        failed_branches+=("$branch")
    fi
done

if [ ${#failed_branches[@]} -gt 0 ]; then
    echo ""
    echo "Failed to replay ${#failed_branches[@]} branch(es):"
    for branch in "${failed_branches[@]}"; do
        echo "  - $branch"
    done
    if [ "$keep_going" != "true" ]; then
        exit 1
    fi
fi
