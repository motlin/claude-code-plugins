---
import Page from '../components/Page.astro';
import Topbar from '../components/Topbar.astro';
import SourceSection from '../components/SourceSection.astro';
import Pager from '../components/Pager.astro';
import data from '../data.json';
const single = data.pages.length === 0;
const options = single
	? data.sections.map((section, index) => ({ value: `section-${index + 1}`, label: section.title }))
	: [{ value: './', label: 'Contents', selected: true }, ...data.pages.map(page => ({ value: `${page.id}/`, label: page.label }))];
const moved = `const moved = ${JSON.stringify(data.moved)};
const page = moved[location.hash.slice(1)];
if (page) location.replace(page + "/" + location.hash);`;
---
<Page>
{single ? <>
<a class="skip" href="#section-1">Skip to code</a>
<Topbar title={data.title} options={options}/>
<noscript><p class="no-script">Complete source and explanations are readable below. Enable JavaScript for synchronized highlights and experiments.</p></noscript>
<main>{data.preface.map(part => <section class="preface" id={part.id}><div class="preface-body"><h2>{part.title}</h2><Fragment set:html={part.markup}/></div></section>)}{data.sections.map((section, index) => <SourceSection section={section} index={index}/>)}
<footer class="references"><Fragment set:html={data.references}/><p>{data.status}</p></footer></main>
</> : <>
<script is:inline set:html={moved}/>
<Topbar title={data.title} home="./" options={options} next={`${data.pages[0].id}/`}/>
<main><section class="preface contents"><div class="preface-body"><h2>Contents</h2><ul>{data.pages.map(page => <li><a href={`${page.id}/`}>{page.label}</a></li>)}</ul></div></section>
<Pager next={{ url: `${data.pages[0].id}/`, label: data.pages[0].label }}/>
<footer class="references"><Fragment set:html={data.references}/><p>{data.status}</p></footer></main>
</>}
</Page>
