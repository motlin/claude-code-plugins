#!/usr/bin/env bash
# Fold a repair into the failing commit, then retest the saved branch.
# Usage: test-fix
# Exit 2 means setup, hooks, commit, or replay failed before retesting.
# Otherwise return test-branch's status; inspect its log for a failing test.

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
phase="validation"
trap 'echo "test-fix failed during $phase; stopped before retesting. Inspect Git state before retrying." >&2; exit 2' ERR

branch=$(cat JUSTFILE_BRANCH)
git show-ref --verify --quiet "refs/heads/$branch"
failing_commit=$(git rev-parse HEAD)
git merge-base --is-ancestor "$failing_commit" "$branch"
if [ -n "$(git branch --show-current)" ]; then
    echo "test-fix requires detached HEAD at the failing commit." >&2
    exit 2
fi
if [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "Stage intended new files and remove unrelated untracked files before test-fix." >&2
    exit 2
fi

phase="staging"
git add --update
if git diff --cached --quiet; then
    echo "No staged repair to fold into the failing commit." >&2
    exit 2
fi

phase="pre-commit hooks"
files=()
while IFS= read -r -d '' file; do
    files+=("$file")
done < <(git diff --cached --name-only -z)

# A formatter can modify files and return nonzero. Retry once after staging
# those edits; a persistent failure must never become a fixup commit.
if ! uv tool run pre-commit run --files "${files[@]}"; then
    if git diff --quiet; then
        echo "Pre-commit failed without formatting changes; no repair commit was created." >&2
        exit 2
    fi
    git add --update
    uv tool run pre-commit run --files "${files[@]}"
fi
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "Pre-commit left unstaged or untracked changes; no repair commit was created." >&2
    exit 2
fi

phase="repair commit"
# Replace only this detached commit, preserving its message and author. Keep an
# empty result if the repair removes the entire change; no descendants are squashed.
git commit --quiet --amend --no-edit --allow-empty
git diff --quiet
git diff --cached --quiet

phase="replay"
echo "Replaying $branch onto the repair for $failing_commit."
if [ "$(git rev-parse "$branch")" = "$failing_commit" ]; then
    git update-ref "refs/heads/$branch" HEAD "$failing_commit"
else
    # Consume replay's documented update-ref protocol explicitly. Older Git
    # prints it by default; newer Git also supports automatic ref updates.
    updates=$(git -c replay.refAction=print replay --onto HEAD "$failing_commit..$branch")
    printf '%s\n' "$updates" | git update-ref --stdin
fi
git merge-base --is-ancestor HEAD "$branch"
git switch --quiet "$branch"

trap - ERR
# Keep the branch marker and use an explicit target even if the test detaches HEAD.
exec "$SCRIPT_DIR/test-branch" "$branch" "${GIT_TESTS:-default}"
