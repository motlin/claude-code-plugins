{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/report-herdr-agent-session.sh\"",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/sync-claude-title-from-herdr.sh\"",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/sync-claude-title-from-herdr.sh\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
