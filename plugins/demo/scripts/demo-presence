#!/usr/bin/env bash

# Report whether the user is at this machine, so a demo is delivered where they
# are rather than opened on a screen they are not looking at.
#
# Prints one `key=value` per line. Exits 0 when the user appears to be here,
# 1 when they appear to be elsewhere, and 2 when it cannot tell.

set -Eeuo pipefail

idle_threshold="${DEMO_IDLE_THRESHOLD:-300}"

idle_seconds=""
screen_locked=""
remote_peers=""
tailscale_up=""

case "$(uname -s)" in
    Darwin)
        idle_seconds="$(ioreg -c IOHIDSystem 2>/dev/null |
            awk '/HIDIdleTime/ {print int($NF / 1000000000); exit}' || true)"
        # Read the key and its value together: absent means no GUI session,
        # which is not the same as an unlocked screen.
        lock_entry="$(ioreg -n Root -d1 -a 2>/dev/null |
            grep -A1 CGSSessionScreenIsLocked || true)"
        case "$lock_entry" in
            *"<true/>"*) screen_locked=true ;;
            *"<false/>"*) screen_locked=false ;;
        esac
        ;;
    Linux)
        if command -v xprintidle >/dev/null 2>&1; then
            idle_seconds="$(($(xprintidle) / 1000))"
        fi
        ;;
esac

if command -v tailscale >/dev/null 2>&1; then
    if tailscale status >/dev/null 2>&1; then
        tailscale_up=true
        remote_peers="$(tailscale status 2>/dev/null |
            awk '$0 ~ /active/ && $1 !~ /^#/ {printf "%s%s", sep, $2; sep=","}' || true)"
    else
        tailscale_up=false
    fi
fi

printf 'idle_seconds=%s\n' "${idle_seconds:-unknown}"
printf 'idle_threshold=%s\n' "$idle_threshold"
printf 'screen_locked=%s\n' "${screen_locked:-unknown}"
printf 'tailscale_up=%s\n' "${tailscale_up:-false}"
printf 'active_remote_peers=%s\n' "${remote_peers:-none}"
printf 'ssh_session=%s\n' "$([ -n "${SSH_TTY:-}" ] && echo true || echo false)"

if [ "$screen_locked" = "true" ]; then
    printf 'verdict=away\n'
    exit 1
fi

if [ -n "$idle_seconds" ] && [ "$idle_seconds" -ge "$idle_threshold" ]; then
    printf 'verdict=away\n'
    exit 1
fi

if [ -z "$idle_seconds" ] && [ -z "$screen_locked" ]; then
    printf 'verdict=unknown\n'
    exit 2
fi

printf 'verdict=present\n'
