#!/usr/bin/env bash

# Run a command and record its real output as a demo step.
#
# Nothing about the output is authored: stdout, stderr and the exit code are
# written straight to files by this script, and the renderer reads those files.

set -Eeuo pipefail

usage() {
    cat <<'EOF'
Usage:
  demo-capture --demo <slug> [options] -- <command> [args...]
  demo-capture --demo <slug> [options] --sh '<shell command>'

Options:
  --demo <slug>       Demo to append to (or $DEMO_SLUG). Required.
  --root <dir>        Demo root (or $DEMO_ROOT). Default: .llm/demo
  --demo-title <text> Title for the demo itself, recorded on first step.
  --title <text>      Title for this step. Default: the command.
  --why <text>        One line on why this command is being run.
  --look-for <text>   What the reader should notice in the output.
  --cwd <dir>         Directory to run the command in. Default: current.
  --redact <ere>      Replace matches of this extended regex with «redacted».
                      Repeatable. Recorded and shown in the rendered demo.
  --allow-failure     Record a non-zero exit as evidence instead of aborting.
  --sh <string>       Run the string through `bash -c` and display it verbatim.
  -h, --help          Show this help.

Exits non-zero when the captured command fails, unless --allow-failure.
EOF
}

root="${DEMO_ROOT:-.llm/demo}"
slug="${DEMO_SLUG:-}"
demo_title=""
title=""
why=""
look_for=""
run_cwd=""
allow_failure=""
shell_string=""
redactions=()
argv=()

while [ $# -gt 0 ]; do
    case "$1" in
        --demo)
            slug="$2"
            shift 2
            ;;
        --root)
            root="$2"
            shift 2
            ;;
        --demo-title)
            demo_title="$2"
            shift 2
            ;;
        --title)
            title="$2"
            shift 2
            ;;
        --why)
            why="$2"
            shift 2
            ;;
        --look-for)
            look_for="$2"
            shift 2
            ;;
        --cwd)
            run_cwd="$2"
            shift 2
            ;;
        --redact)
            redactions+=("$2")
            shift 2
            ;;
        --allow-failure)
            allow_failure=1
            shift
            ;;
        --sh)
            shell_string="$2"
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            argv=("$@")
            break
            ;;
        *)
            echo "demo-capture: unexpected argument '$1'" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ -z "$slug" ]; then
    echo "demo-capture: --demo <slug> is required (or set DEMO_SLUG)" >&2
    exit 2
fi

if [ -n "$shell_string" ] && [ ${#argv[@]} -gt 0 ]; then
    echo "demo-capture: use either --sh or -- <command>, not both" >&2
    exit 2
fi

if [ -z "$shell_string" ] && [ ${#argv[@]} -eq 0 ]; then
    echo "demo-capture: no command given" >&2
    usage >&2
    exit 2
fi

if [ -n "$shell_string" ]; then
    display="$shell_string"
    argv=(bash -c "$shell_string")
else
    display="$(printf '%q ' "${argv[@]}")"
    display="${display% }"
fi

demo_dir="$root/$slug"
mkdir -p "$demo_dir/steps"

if [ ! -f "$demo_dir/created" ]; then
    printf '%s\n' "${demo_title:-$slug}" >"$demo_dir/title"
    date -u +%Y-%m-%dT%H:%M:%SZ >"$demo_dir/created"
    printf '%s\n' "$PWD" >"$demo_dir/cwd"
    hostname >"$demo_dir/host"
    git rev-parse HEAD >"$demo_dir/git_commit" 2>/dev/null || true
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        printf 'dirty\n' >"$demo_dir/git_dirty"
    fi
elif [ -n "$demo_title" ]; then
    printf '%s\n' "$demo_title" >"$demo_dir/title"
fi

count=$(find "$demo_dir/steps" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
step_dir="$(printf '%s/steps/%03d' "$demo_dir" "$((count + 1))")"
mkdir -p "$step_dir"

printf 'command\n' >"$step_dir/kind"
printf '%s\n' "${title:-$display}" >"$step_dir/title"
printf '%s\n' "$display" >"$step_dir/command"
if [ -n "$why" ]; then
    printf '%s\n' "$why" >"$step_dir/why"
fi
if [ -n "$look_for" ]; then
    printf '%s\n' "$look_for" >"$step_dir/look_for"
fi
printf '%s\n' "${run_cwd:-$PWD}" >"$step_dir/cwd"
date -u +%Y-%m-%dT%H:%M:%SZ >"$step_dir/started"
started_epoch=$(date +%s)

status=0
if [ -n "$run_cwd" ]; then
    (cd "$run_cwd" && "${argv[@]}") >"$step_dir/stdout" 2>"$step_dir/stderr" || status=$?
else
    "${argv[@]}" >"$step_dir/stdout" 2>"$step_dir/stderr" || status=$?
fi

date -u +%Y-%m-%dT%H:%M:%SZ >"$step_dir/ended"
printf '%s\n' "$(($(date +%s) - started_epoch))" >"$step_dir/duration_seconds"
printf '%s\n' "$status" >"$step_dir/exit"

if [ ${#redactions[@]} -gt 0 ]; then
    for pattern in "${redactions[@]}"; do
        printf '%s\n' "$pattern" >>"$step_dir/redactions"
        for stream in stdout stderr; do
            sed -E "s/${pattern//\//\\/}/«redacted»/g" "$step_dir/$stream" >"$step_dir/$stream.tmp"
            mv "$step_dir/$stream.tmp" "$step_dir/$stream"
        done
    done
fi

preview() {
    local stream="$1" lines
    [ -s "$step_dir/$stream" ] || return 0
    lines=$(wc -l <"$step_dir/$stream" | tr -d ' ')
    echo "--- $stream ($lines lines, $step_dir/$stream)"
    head -n 40 "$step_dir/$stream"
    if [ "$lines" -gt 40 ]; then
        echo "--- $((lines - 40)) more lines in $step_dir/$stream"
    fi
}

echo "captured $step_dir (exit $status)" >&2
preview stdout
preview stderr

if [ "$status" -ne 0 ] && [ -z "$allow_failure" ]; then
    echo "demo-capture: command failed with exit $status; pass --allow-failure to keep it as evidence" >&2
    exit "$status"
fi
